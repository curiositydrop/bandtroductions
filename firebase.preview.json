{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firebase.preview.json",
      "**/.*",
      "**/node_modules/**",
      "functions/**",
      "tests/**"
    ],
    "headers": [
      {
        "source": "/og/*.jpg",
        "headers": [
          {
            "key": "Content-Type",
            "value": "image/jpeg"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      }
    ]
  }
}
