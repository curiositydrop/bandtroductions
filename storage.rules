rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    /* FINAL: admin must have a verified email (matches Firestore rules) */
    function isVerifiedAdmin() {
      return request.auth != null
        && 'email' in request.auth.token
        && request.auth.token.email == 'mbergeron79@gmail.com'
        && (request.auth.token.email_verified == true
            || request.auth.uid == 'PJXufsvdCCgRpfKcLtxPH3jEQN83');
    }

    function isOwnerOrAdmin(userId) {
      return (request.auth != null && request.auth.uid == userId)
        || isVerifiedAdmin();
    }

    /* CURRENT PROFILE MEDIA PATH */
    match /profile-media/{userId}/{fileName} {
      allow read: if true;
      allow delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size > 0
                   && (
                     (request.resource.size < 20 * 1024 * 1024
                      && request.resource.contentType.matches('image/(jpeg|png|webp|gif|heic|heif)'))
                     || (request.resource.size <= 100 * 1024 * 1024
                      && request.resource.contentType.matches('video/(mp4|quicktime|webm)'))
                   );
    }

    /* OLDER PROFILE MEDIA PATH */
    match /users/{userId}/profile-media/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && (
                     request.resource == null
                     || (
                       request.resource.size < 20 * 1024 * 1024
                       && request.resource.contentType.matches('image/(jpeg|png|webp|gif)')
                     )
                   );
    }

    /* OTHER USER IMAGE FOLDERS */
    match /users/{userId}/{folder}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && (
                     request.resource == null
                     || (
                       request.resource.size < 20 * 1024 * 1024
                       && request.resource.contentType.matches('image/(jpeg|png|webp|gif)')
                     )
                   );
    }

    /* WEBSITE SHOW FLYERS */
    match /show-flyers/{userId}/{fileName} {
      allow read: if true;
      allow create, update: if request.auth != null
                            && request.auth.uid == userId
                            && request.resource.size > 0
                            && request.resource.size < 10 * 1024 * 1024
                            && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    /* BANDTRODUCTIONS RADIO SUBMISSIONS */
    match /radio-submissions/{userId}/{fileName} {
      allow read: if isOwnerOrAdmin(userId);
      allow create, update: if request.auth != null
                            && request.auth.uid == userId
                            && (
                              (request.resource.contentType == 'audio/mpeg'
                               && request.resource.size < 25 * 1024 * 1024)
                              ||
                              (request.resource.contentType.matches('image/.*')
                               && request.resource.size < 10 * 1024 * 1024)
                            );
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    /* ADMIN SONG / SHOW UPLOADS: MP3 files up to 250 MB */
    match /radio-admin/{userId}/{fileName} {
      allow get: if true;
      allow list: if isVerifiedAdmin();
      allow create, update: if request.auth != null
                            && request.auth.uid == userId
                            && isVerifiedAdmin()
                            && (request.resource.contentType == 'audio/mpeg'
                                || (fileName.matches('station-id-.*\\.m4a')
                                    && request.resource.contentType == 'audio/mp4'))
                            && request.resource.size > 0
                            && request.resource.size <= 250 * 1024 * 1024;
      allow delete: if request.auth != null
                    && request.auth.uid == userId
                    && isVerifiedAdmin();
    }

    /* Admin-only between-show advertising media. Public playback, verified admin uploads. */
    match /between-show-ads/{userId}/{fileName} {
      allow get: if true;
      allow list: if isVerifiedAdmin();
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && isVerifiedAdmin()
                    && request.resource.size > 0
                    && (
                      (request.resource.size <= 40 * 1024 * 1024
                       && request.resource.contentType == 'video/mp4')
                      || (request.resource.size <= 15 * 1024 * 1024
                       && request.resource.contentType.matches('audio/(mpeg|mp4|x-m4a|m4a|wav)'))
                      || (request.resource.size <= 10 * 1024 * 1024
                       && request.resource.contentType.matches('image/(jpeg|png|webp)'))
                    );
      allow update, delete: if false;
    }

    /* AUDITION ROOM VIDEO SUBMISSIONS */
    match /auditions/{userId}/{fileName} {
      allow read: if isOwnerOrAdmin(userId);
      allow create, update: if request.auth != null
                            && request.auth.uid == userId
                            && request.resource.size < 150 * 1024 * 1024
                            && request.resource.contentType.matches('video/.*');
      allow delete: if request.auth != null
                    && (
                      request.auth.uid == userId
                      || isVerifiedAdmin()
                    );
    }
  }
}
