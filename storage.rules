rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Public profile images. A signed-in user may only write inside
    // their own Firebase Auth UID folder.
    match /users/{userId}/profile-media/{fileName} {
      allow read: if true;
      allow create, update: if request.auth != null
                            && request.auth.uid == userId
                            && request.resource.size < 20 * 1024 * 1024
                            && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Existing user image folders remain supported.
    match /users/{userId}/{folder}/{fileName} {
      allow read: if true;
      allow create, update: if request.auth != null
                            && request.auth.uid == userId
                            && request.resource.size < 20 * 1024 * 1024
                            && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Audition Room video submissions. Members may upload video only
    // inside their own UID folder. Videos are capped at 150 MB.
    match /auditions/{userId}/{fileName} {
      allow read: if true;
      allow create, update: if request.auth != null
                            && request.auth.uid == userId
                            && request.resource.size < 150 * 1024 * 1024
                            && request.resource.contentType.matches('video/.*');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // BANDtroductions Radio submissions. Members can upload only inside
    // their own UID folder. Audio is capped at 25 MB and cover art at 10 MB.
    match /radio-submissions/{userId}/{fileName} {
      allow read: if true;
      allow create, update: if request.auth != null
                            && request.auth.uid == userId
                            && (
                              (request.resource.contentType == 'audio/mpeg' && request.resource.size < 25 * 1024 * 1024)
                              ||
                              (request.resource.contentType.matches('image/.*') && request.resource.size < 10 * 1024 * 1024)
                            );
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
